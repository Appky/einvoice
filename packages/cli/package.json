{
  "name": "einvoice-cli",
  "version": "0.1.0",
  "description": "Command-line validator and viewer for EU e-invoices: EN 16931, XRechnung, Factur-X/ZUGFeRD, UBL, CII, Peppol BIS. No Java, no uploads.",
  "type": "module",
  "bin": {
    "einvoice": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');const p='dist/cli.js';fs.writeFileSync(p,'#!/usr/bin/env node\\n'+fs.readFileSync(p,'utf8'));fs.chmodSync(p,0o755)\""
  },
  "dependencies": {
    "einvoice": "^0.1.0"
  },
  "keywords": [
    "e-invoice",
    "en16931",
    "xrechnung",
    "factur-x",
    "zugferd",
    "ubl",
    "cii",
    "peppol",
    "validator",
    "cli"
  ],
  "author": "Juraj (appky.sk) and Claude (Anthropic)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurco321/einvoice.git"
  },
  "homepage": "https://jurco321.github.io/einvoice/",
  "engines": {
    "node": ">=18"
  }
}
