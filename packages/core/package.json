{
  "name": "einvoice-kit",
  "version": "0.4.0",
  "bin": {
    "einvoice-kit": "dist/cli.js"
  },
  "description": "EU e-invoicing toolkit for JavaScript/TypeScript: create, parse, validate (EN 16931 + XRechnung BR-DE + Peppol BIS, ~230 native rules) and render UBL, CII and Factur-X/ZUGFeRD invoices. Zero dependencies; Node, browser, edge.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');const p='dist/cli.js';fs.writeFileSync(p,'#!/usr/bin/env node\\n'+fs.readFileSync(p,'utf8'));fs.chmodSync(p,0o755)\"",
    "test": "vitest run"
  },
  "keywords": [
    "e-invoice",
    "einvoice",
    "en16931",
    "xrechnung",
    "factur-x",
    "facturx",
    "zugferd",
    "ubl",
    "cii",
    "peppol",
    "invoice",
    "validation",
    "vat",
    "e-rechnung",
    "e-invoicing",
    "generator",
    "create-invoice",
    "xrechnung-generator"
  ],
  "author": "Appky (https://appky.sk)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Appky/einvoice.git"
  },
  "homepage": "https://appky.github.io/einvoice/",
  "bugs": {
    "url": "https://github.com/Appky/einvoice/issues"
  },
  "engines": {
    "node": ">=18"
  }
}